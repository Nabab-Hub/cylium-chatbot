# Active LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Gemini Configuration (for future switch)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Project Configuration
FIREBASE_PROJECT_ID=cyliumos

# Optional: Path to Firebase Service Account Credentials JSON file
FIREBASE_CREDENTIALS=cyliumos-firebase-adminsdk.json

# Optional: Raw JSON string of Firebase Service Account (useful for Docker / Cloud Run / Render)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server Configuration
HOST=0.0.0.0
PORT=8002
DEBUG=false

# Allowed Origins for CORS (comma-separated or * for all)
CORS_ORIGINS=*

# RAG Knowledge Cache TTL in Seconds (default: 120s)
RAG_CACHE_TTL_SECONDS=120

# Anonymous Session In-Memory Cache TTL in Seconds (default: 3600s = 1 hour)
ANONYMOUS_SESSION_TTL_SECONDS=3600
